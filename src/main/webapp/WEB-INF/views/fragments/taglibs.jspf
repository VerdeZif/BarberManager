<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="bm" tagdir="/WEB-INF/tags" %>
<%-- Formato peruano: S/ 25.00 --%>
<fmt:setLocale value="es_PE" scope="request"/>
<c:set var="ctx" value="${pageContext.request.contextPath}" scope="request"/>
<%-- Sesión que crea LoginServlet: usuarioId (Long) y rol (String). username es opcional. --%>
<c:set var="logueado" value="${not empty sessionScope.usuarioId}" scope="request"/>
<c:set var="rolSesion" value="${logueado ? sessionScope.rol : ''}" scope="request"/>
<c:set var="nombreSesion" value="${not empty sessionScope.username ? sessionScope.username : 'tu cuenta'}" scope="request"/>
