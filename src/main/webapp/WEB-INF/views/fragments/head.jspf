<%@ page pageEncoding="UTF-8" %>
<%--
  Cabecera HTML común.
  Antes de incluirlo, la página define: tituloPagina (texto de la pestaña)
  y, opcional, descripcionPagina.
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty tituloPagina ? 'BarberManager' : tituloPagina.concat(' · BarberManager')}"/></title>
    <meta name="description" content="<c:out value='${empty descripcionPagina ? "Reserva tu corte, barba o afeitado en línea con BarberManager." : descripcionPagina}'/>">
    <meta name="theme-color" content="#3B0D17">
    <link rel="icon" href="${ctx}/assets/img/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="${ctx}/assets/css/barber.css">
</head>
<body>
<a class="bm-skip" href="#contenido">Saltar al contenido</a>
